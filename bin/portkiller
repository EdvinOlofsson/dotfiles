#!/bin/bash

# Parse arguments
PORT=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --port)
            PORT="$2"
            shift 2
            ;;
        *)
            echo "Usage: $0 --port <port_number>"
            exit 1
            ;;
    esac
done

# Check if port was provided
if [ -z "$PORT" ]; then
    echo "Error: --port argument is required"
    echo "Usage: $0 --port <port_number>"
    exit 1
fi

# Find process using the port
PID=$(lsof -ti :$PORT 2>/dev/null)

if [ -z "$PID" ]; then
    echo "No process found running on port $PORT"
    exit 0
fi

# Show process information
echo "Process found on port $PORT:"
ps -p $PID -o pid,user,command

# Ask for confirmation
read -p "Kill this process? (y/n): " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    kill $PID
    if [ $? -eq 0 ]; then
        echo "Process $PID killed successfully"
    else
        echo "Failed to kill process $PID"
        exit 1
    fi
else
    echo "Process not killed"
fi
